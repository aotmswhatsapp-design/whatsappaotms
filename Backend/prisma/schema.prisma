// Control-plane schema.
//
// Identity lives in Supabase Auth; this database holds the business records and
// keys them by the Supabase user id, so no password material is ever stored
// here. Tenant data (WhatsApp accounts, conversations) will hang off Workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_POSTGRES_URL")
  // Runtime traffic goes through the transaction pooler (6543), which cannot
  // carry the prepared statements a migration needs. Prisma migrates over this
  // direct connection instead.
  directUrl = env("DIRECT_URL")
}

enum GlobalRole {
  USER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  /// The PRD's Manager: campaigns, contacts, analytics and assignment,
  /// without the workspace-wide reach of an ADMIN.
  MANAGER
  /// The PRD's Support Agent.
  AGENT
}

enum PlanTier {
  STARTER
  GROWTH
  SCALE
}

/// Mirrors `auth.users.id` from Supabase. Never create rows independently of a
/// verified access token.
model User {
  id         String     @id @db.Uuid
  email      String     @unique
  fullName   String?    @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  role       GlobalRole @default(USER)
  lastSeenAt DateTime?  @map("last_seen_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  memberships WorkspaceMember[]
  owned       Workspace[]       @relation("WorkspaceOwner")
  /// One per workspace this user has connected a number in.
  whatsapp    WhatsAppAccount[]
  /// Invitations this user sent, kept after acceptance as an audit trail.
  sentInvitations WorkspaceInvitation[] @relation("InvitationsSent")

  assignedConversations Conversation[] @relation("ConversationAssignee")
  notes                 InternalNote[] @relation("NoteAuthor")
  /// Follow-up tasks this user owns.
  tasks                 FollowUpTask[] @relation("TaskAssignee")
  /// Threads this user paused the agent on by replying to one.
  aiPauses              Conversation[] @relation("AiPauseActor")

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      PlanTier @default(STARTER)
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]
  /// Pending and accepted invitations. Acceptance becomes a membership; the
  /// row stays behind so the team screen can say who invited whom.
  invitations WorkspaceInvitation[]

  /// Tenant data. Every conversation, message and contact is scoped here so
  /// one agent's inbox cannot read another workspace's threads.
  whatsapp      WhatsAppAccount[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  templates     MessageTemplate[]
  campaigns     Campaign[]
  agents        Agent[]
  botFlows      BotFlow[]
  followUpTasks FollowUpTask[]
  crmSettings   CrmSettings?

  /// The owner's module toggles, one row per role and module. Absent rows fall
  /// back to the defaults in `Backend/src/workspaces/modules.ts`, so a workspace
  /// that never opened the permissions screen needs no rows at all.
  roleAccess WorkspaceRoleAccess[]

  /// Cost and usage snapshots. Kept per workspace so no report can ever
  /// straddle two tenants.
  templateStats TemplateDailyStat[]
  pricingStats  PricingDailyStat[]
  analyticsSync AnalyticsSyncState?
  analyticsRuns AnalyticsSyncRun[]

  /// The workspace's own identity. Customers never see these fields: the
  /// profile they see on WhatsApp lives in Meta and is read through Graph.
  businessProfile BusinessProfile?

  @@index([ownerId])
  @@map("workspaces")
}

/// One module switched on or off for one role.
///
/// Only the deviations are stored: a row exists when the owner changed a
/// module from its default. The reader merges these rows over the defaults, so
/// adding a module later does not silently vanish from every workspace.
/// Ownership is never stored here — an OWNER sees every module by definition.
model WorkspaceRoleAccess {
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole
  /// One of `MODULE_KEYS`; a hand-edited unknown key is ignored on read.
  module      String
  enabled     Boolean       @default(true)
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, role, module])
  @@map("workspace_role_access")
}

/// One row per workspace, created on the first successful save rather than on
/// read: a page load is not a reason to write.
model BusinessProfile {
  workspaceId   String   @id @map("workspace_id") @db.Uuid
  companyName   String?  @map("company_name")
  website       String?
  /// IANA name, e.g. Asia/Kolkata. Drives scheduled sends, so it has a default
  /// rather than being nullable.
  timezone      String   @default("Asia/Kolkata")
  supportNumber String?  @map("support_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(AGENT)
  /// Free text: "Sales Executive", "Support Agent". Round-robin filters on it.
  designation      String?   @map("designation")
  /// Digits only, country code first, no "+" — the same shape as Contact.waId.
  personalWhatsApp String?   @map("personal_whatsapp")
  /// Round-robin cursor. Written only by the lead router, never by a manual
  /// reassignment in the inbox: handing a thread over must not skew rotation.
  lastAssignedAt   DateTime? @map("last_assigned_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, designation])
  @@map("workspace_members")
}

/// One invitation to join a workspace, by email.
///
/// The link carries a random token and the database keeps only its SHA-256, so
/// a leaked table cannot be replayed as invitations. Acceptance requires the
/// signed-in account's email to match, which is what stops a forwarded link
/// from adding the wrong person. A partial unique index
/// (`workspace_invitations_one_pending_per_email`) allows one pending row per
/// address per workspace — re-inviting replaces rather than stacks.
model WorkspaceInvitation {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  /// Lower-cased at write time, so matching at acceptance is exact.
  email           String
  /// ADMIN or AGENT. Ownership is not transferable through an invitation.
  role            WorkspaceRole
  tokenHash       String        @unique @map("token_hash")
  invitedByUserId String        @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at")
  acceptedAt      DateTime?     @map("accepted_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}

enum WhatsAppStatus {
  VERIFIED
  FAILED
}

/// Where the credentials came from. Only `MANUAL` is written now: every row is
/// a customer's own Meta app, verified against Graph before it is stored. The
/// second value is kept because Postgres cannot drop an enum member without a
/// rewrite, and rows created by the retired one-click flow must stay readable.
enum WhatsAppSource {
  MANUAL
  EMBEDDED_SIGNUP
}

/// One Meta WhatsApp Business connection per user.
///
/// The access token, the app secret and the webhook verify token are
/// AES-256-GCM ciphertext at rest. Only last-four hints leave the API, plus the
/// verify token itself — the customer has to paste that one into Meta's console,
/// so it cannot stay hidden.
///
/// A row exists only for credentials Meta confirmed, so status is VERIFIED on
/// write; FAILED is reserved for a live re-check that no longer passes.
/// `webhook_verified_at` is the line between "credentials accepted" and
/// "actually receiving events": the sidebar is amber until it is set, and that
/// state is derived rather than stored.
model WhatsAppAccount {
  id                 String         @id @default(uuid()) @db.Uuid
  /// Who connected it. Kept as an audit trail; tenancy is `workspaceId`.
  userId             String         @map("user_id") @db.Uuid
  /// Not unique: a workspace may connect several numbers. A number, however,
  /// belongs to exactly one workspace — `phoneNumberId` is unique, because that
  /// is the key Meta names in every delivery and two owners would mean two
  /// agents answering the same customer.
  workspaceId        String         @map("workspace_id") @db.Uuid
  /// A name the workspace gives this number, so two of them can be told apart
  /// without reading the digits. Null means the screen shows the number itself.
  label              String?
  /// The number a workspace answers from when nothing names another: the one a
  /// campaign, a template submission or a report reads. At most one per
  /// workspace, enforced by the partial unique index
  /// `whatsapp_accounts_one_default_per_workspace`, not by the service.
  isDefault          Boolean        @default(false) @map("is_default")
  phoneNumberId      String         @unique @map("phone_number_id")
  businessAccountId  String         @map("business_account_id")
  graphVersion       String         @map("graph_version")
  /// The Meta app that issued the access token. Template image uploads are
  /// addressed by app id and Meta requires the token to belong to that same
  /// app, so this is a per-connection value rather than a platform one.
  /// Nullable: rows connected before the field existed stay usable.
  appId              String?        @map("app_id")
  displayPhoneNumber String?        @map("display_phone_number")
  verifiedName       String?        @map("verified_name")
  qualityRating      String?        @map("quality_rating")
  businessName       String?        @map("business_name")
  /// The WABA's billing currency, as Graph reports it (`INR`, `USD`, …).
  /// Null until the currency read succeeds; money is never formatted with an
  /// assumed currency, so a null here means the UI says nothing rather than
  /// guessing.
  currency            String?        @map("currency")
  status             WhatsAppStatus @default(VERIFIED)
  source             WhatsAppSource @default(MANUAL)
  lastVerifiedAt     DateTime?      @map("last_verified_at")
  accessTokenCipher  String         @map("access_token_cipher")
  verifyTokenCipher  String         @map("verify_token_cipher")
  /// Nullable: rows written before app secrets were collected stay readable.
  appSecretCipher    String?        @map("app_secret_cipher")
  /// Stamped by Meta's GET handshake, cleared when the token is rotated.
  webhookVerifiedAt  DateTime?      @map("webhook_verified_at")
  /// Delivery proof for the WhatsApp screen. Message content lives in
  /// `messages`, written by the inbox store after a signature check.
  lastEventAt        DateTime?      @map("last_event_at")
  eventCount         Int            @default(0) @map("event_count")
  /// Cache marker for the live re-check, so a page load is not a Meta call.
  lastCheckAt        DateTime?      @map("last_check_at")
  /// Stamped when the customer turned on per-template insights. Meta's switch
  /// is one-way and per WABA, so this records a promise rather than a setting
  /// we can toggle back.
  insightsEnabledAt  DateTime?      @map("insights_enabled_at")
  /// True when Meta reports the number is also in use in the WhatsApp
  /// Business app. `smb_app_data` is legal only for these rows, so this
  /// decides whether the two sync calls are attempted at all.
  onBizApp             Boolean   @default(false) @map("on_biz_app")
  /// Written only after Meta accepted the request, which is what makes a
  /// retry safe: an unaccepted request leaves these null.
  stateSyncAt          DateTime? @map("state_sync_at")
  stateSyncRequestId   String?   @map("state_sync_request_id")
  historySyncAt        DateTime? @map("history_sync_at")
  historySyncRequestId String?   @map("history_sync_request_id")
  /// Meta reported `progress: 100`, or declined the sync. Null means the
  /// history is still arriving or was never asked for.
  historySyncDoneAt    DateTime? @map("history_sync_done_at")
  /// The sentence the connection screen shows: a refusal, a decline, a dead
  /// token. Cleared when a new history request succeeds.
  historySyncError     String?   @map("history_sync_error")
  /// When the stored business token lapses, as Meta reported at connect time.
  /// Null means "Meta said it never expires" or "not yet known" — the UI says
  /// nothing rather than guessing, matching how `currency` behaves.
  tokenExpiresAt     DateTime?      @map("token_expires_at")
  failureReason      String?        @map("failure_reason")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  /// Several of these may be on duty at once: a new thread is routed to the
  /// one whose description fits it, and keeps that one for the whole thread.
  agents        Agent[]

  /// A delivery is looked up by the number alone, which is why the column is
  /// unique rather than indexed.
  /// The default-account lookup reads by workspace, which is not unique.
  @@index([workspaceId])
  @@map("whatsapp_accounts")
}

/// Every GET Meta's console sends to the webhook endpoint — matched or not.
///
/// Without this, "Meta never called" and "Meta called with a token that is not
/// ours" produce the same silence, and the connection screen can only
/// apologise. Rows are pruned after seven days, only the last four characters
/// of the presented token are stored (enough to tell two apart, useless as a
/// credential), and there is deliberately no foreign key: the trace has to
/// outlive the connection it failed to complete.
model WebhookAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  at               DateTime @default(now())
  /// `hub.mode` as sent. Null when the request omitted it.
  mode             String?
  /// Last four characters of `hub.verify_token`; never the token itself.
  tokenHint        String?  @map("token_hint")
  /// Set when the token matched a workspace's, so a screen can claim the call.
  matchedAccountId String?  @map("matched_account_id") @db.Uuid
  /// Meta's egress address, for telling one caller apart from another.
  ip               String?

  @@index([at])
  @@index([matchedAccountId])
  @@map("webhook_attempts")
}

// ---------------------------------------------------------------------------
// Inbox (PRD MODULE 5).
//
// This is the first place customer content is stored: phone numbers, names and
// message text. Nothing here is ever written to logs, and deleting a
// conversation must also delete its stored media.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageKind {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  CONTACTS
  BUTTON
  INTERACTIVE
  /// A message sent from an approved template. `body` holds it as the customer
  /// reads it, with Meta's variables already filled in.
  TEMPLATE
  /// One emoji on someone else's message. `body` is the emoji and
  /// `contextWamid` names the message it sits on, so a reaction is never
  /// mistaken for a reply.
  REACTION
  UNSUPPORTED
  /// A history row whose chunk carried no contents: the media asset arrives in
  /// a separate webhook, and only for the last 14 days.
  MEDIA_PENDING
}

/// QUEUED exists so a crash between our insert and Meta's answer leaves a
/// visible row instead of a message that vanished.
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// One customer identity inside a workspace, created by the webhook from
/// `value.contacts[]` so the inbox works before the Contacts module exists.
model Contact {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  /// Digits only, exactly as Meta sends it (`wa_id`).
  waId         String    @map("wa_id")
  profileName  String?   @map("profile_name")
  phoneDisplay String?   @map("phone_display")
  /// Optional, imported with a campaign list. Never used in a send: Meta's
  /// template parameters are name and number only.
  email        String?
  /// The customer's own reference (membership, order, CRM id), imported with
  /// the list so an agent can recognise the row without opening the CRM.
  externalId   String?   @map("external_id")
  tags         String[]  @default([])
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  campaigns     CampaignRecipient[]

  @@unique([workspaceId, waId])
  @@index([workspaceId, lastSeenAt])
  @@map("contacts")
}

/// A thread with one contact on one number.
///
/// `lastInboundAt` is what the 24-hour service window is measured from;
/// `lastMessageAt` and `unreadCount` are denormalised so the list is a single
/// indexed query instead of an aggregate per row.
model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @map("workspace_id") @db.Uuid
  accountId          String             @map("account_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  status             ConversationStatus @default(OPEN)
  assignedToUserId   String?            @map("assigned_to_user_id") @db.Uuid
  /// Set the moment a human replies, or when the agent hands off. The agent
  /// stops answering for this thread until it is cleared.
  aiPausedAt         DateTime?          @map("ai_paused_at")
  aiPausedByUserId   String?            @map("ai_paused_by_user_id") @db.Uuid
  aiPauseReason      String?            @map("ai_pause_reason")
  /// What the customer's words said about buying, decided by
  /// `Backend/src/crm/interest.rules.ts`. UNKNOWN is "nothing said yet".
  interest           LeadInterest @default(UNKNOWN)
  /// The evidence of the message that decided the stage, clamped ±100.
  interestScore      Int?               @map("interest_score")
  /// The phrase that decided it (`matched "how much" (BUYING)`), `no buying or
  /// refusal signal`, or `manual` after an override.
  interestReason     String?            @map("interest_reason")
  interestAt         DateTime?          @map("interest_at")
  /// The agent that answers this thread. Written on the first inbound message
  /// and kept, because two agents on one number must never take turns inside
  /// one conversation. Cleared — never cascaded — when that agent is deleted,
  /// which frees the thread to be bound again.
  agentId            String?            @map("agent_id") @db.Uuid
  lastInboundAt      DateTime?          @map("last_inbound_at")
  lastMessageAt      DateTime           @default(now()) @map("last_message_at")
  lastMessagePreview String?            @map("last_message_preview")
  unreadCount        Int                @default(0) @map("unread_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact    Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  aiPausedBy User?           @relation("AiPauseActor", fields: [aiPausedByUserId], references: [id], onDelete: SetNull)
  agent      Agent?          @relation("ConversationAgent", fields: [agentId], references: [id], onDelete: SetNull)
  messages   Message[]
  notes      InternalNote[]
  followUpTasks FollowUpTask[]

  @@unique([accountId, contactId])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, interest, lastMessageAt])
  @@index([assignedToUserId])
  @@index([agentId])
  @@map("conversations")
}

/// One WhatsApp message in either direction.
///
/// `wamid` is Meta's id and the dedupe key: deliveries are retried, and the
/// same message must never become two rows. Media bytes live in Supabase
/// Storage; `mediaPath` stays null until the first open downloads them.
model Message {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  kind           MessageKind      @default(TEXT)
  status         MessageStatus    @default(QUEUED)
  wamid          String?          @unique
  body           String?
  mediaId        String?          @map("media_id")
  mediaMime      String?          @map("media_mime")
  mediaName      String?          @map("media_name")
  mediaSize      Int?             @map("media_size")
  mediaSha256    String?          @map("media_sha256")
  mediaPath      String?          @map("media_path")
  /// Set on a `TEMPLATE` row: which Meta template produced the bubble.
  templateName     String?        @map("template_name")
  templateLanguage String?        @map("template_language")
  /// The `tap_target_configuration` override that was sent, kept verbatim so
  /// the thread can say what a customer's link opened.
  tapTarget      Json?            @map("tap_target")
  errorReason    String?          @map("error_reason")
  /// The wamid this message quotes. Set from `context.id` when Meta sends a
  /// quote, and from the row an agent answered when we send one. Both sides of
  /// a reply chain are stored, which is the only way a thread can draw it.
  contextWamid   String?          @map("context_wamid")
  /// Contents of a kind that is neither text nor a file: a location's
  /// coordinates, a contact card's fields. Typed by `kind`, never guessed.
  payload        Json?
  /// A row mirrored from the WhatsApp Business app's history. Echoes and live
  /// deliveries stay false: those happened while we were listening.
  imported       Boolean          @default(false)
  /// Set by the campaign runner. Null for every other send, which is what
  /// keeps campaign insights a single indexed groupBy.
  campaignId     String?          @map("campaign_id") @db.Uuid
  /// Which agent wrote it. Null for every human and campaign send.
  agentId        String?          @map("agent_id") @db.Uuid
  sentAt         DateTime?        @map("sent_at")
  deliveredAt    DateTime?        @map("delivered_at")
  readAt         DateTime?        @map("read_at")
  /// Set when an agent hides this bubble from the inbox. The row survives:
  /// Meta has no revoke endpoint, `wamid` is the dedupe key for retried
  /// deliveries, and campaign and analytics history point at it. The customer
  /// still has the message on their phone.
  deletedAt       DateTime?       @map("deleted_at")
  deletedByUserId String?         @map("deleted_by_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Back-relation for the campaign that sent it, if any.
  recipient    CampaignRecipient?
  agent        Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([contextWamid])
  @@index([campaignId])
  @@index([agentId])
  @@map("messages")
}

/// Agent-only. Kept out of `Message` so a note can never reach the send path
/// by mistake.
model InternalNote {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("internal_notes")
}

// ---------------------------------------------------------------------------
// Templates (Meta message templates).
//
// Meta is the source of truth: a row here is a cache of what the account holds,
// keyed by the id Meta assigned. `metaId` is nullable because a submission Meta
// rejects outright never gets an id, and that rejection is still worth keeping.
// ---------------------------------------------------------------------------

enum TemplateCategory {
  AUTHENTICATION
  MARKETING
  UTILITY
}

enum ParameterFormat {
  NAMED
  POSITIONAL
}

/// Every value Meta documents for a template's `status`. Stored as a string
/// rather than an enum: Meta adds states over time, and an unknown state must
/// render as itself instead of failing the sync of the whole account.
model MessageTemplate {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  /// The template id Meta assigned. Null until Meta accepts the creation call.
  metaId          String?         @map("meta_id")
  name            String
  language        String
  category        TemplateCategory
  parameterFormat ParameterFormat @default(POSITIONAL) @map("parameter_format")
  status          String          @default("PENDING")
  /// GREEN / YELLOW / RED, or null before the first quality signal.
  qualityScore    String?         @map("quality_score")
  rejectedReason  String?         @map("rejected_reason")
  /// The exact `components` array sent to Meta, verbatim. Rebuilding it from
  /// our own fields would drift; an audit has to see what was submitted.
  components      Json
  /// The sample image we keep for an IMAGE header: our own copy, in the
  /// `template-media` bucket, so the card still shows it after Meta's handle
  /// expires. Null for text headers and for templates made in WhatsApp Manager.
  mediaPath       String?         @map("media_path")
  mediaMime       String?         @map("media_mime")
  mediaSize       Int?            @map("media_size")
  /// The `4::…` handle the Resumable Upload API minted at creation time.
  /// Recorded for diagnosis only: handles expire, our object does not.
  mediaHandle     String?         @map("media_handle")
  mediaUploadedAt DateTime?       @map("media_uploaded_at")
  lastSyncedAt    DateTime?       @map("last_synced_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  /// One row per Meta template. Two workspaces can never share an id, but the
  /// pair is the real key: a sync upserts on it.
  @@unique([workspaceId, metaId])
  /// Name + language is Meta's own uniqueness rule; a row without a metaId
  /// still cannot be duplicated.
  @@unique([workspaceId, name, language])
  @@index([workspaceId, status])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Campaigns (PRD MODULE 4).
//
// A campaign is an approved template sent to an audience: either the tags a
// contact carries, or a list of numbers the workspace typed or imported. This
// is NOT Meta's "Messaging campaigns in Meta Business Suite": that tool has no
// API, so a row here can never mirror one. Sends go through the Cloud API and
// land in the recipient's own Inbox conversation, which is why the message
// rows, not this table, carry delivery and read.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  /// The run stopped for a reason the workspace has to fix, such as a
  /// disconnected number. Recipients that never sent are SKIPPED.
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Where a campaign's audience comes from. `SEGMENT` is the live tag query:
/// every contact matching the tags, measured again at start. `LIST` is the
/// numbers the workspace typed or imported, which exist as recipient rows
/// from the moment they are added.
enum AudienceSource {
  LIST
  SEGMENT
}

/// One broadcast: an approved template, an audience and a schedule. Counters
/// are written only by the campaign runner, so they cannot disagree with the
/// recipient rows.
model Campaign {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  /// Which number the run sends from. Null until the first send pins it, which
  /// is also the state of a campaign drafted before a workspace could hold more
  /// than one number. Not a foreign key on purpose: disconnecting a number must
  /// not erase the campaigns it ran, the same rule `template_daily_stats`
  /// follows.
  whatsappAccountId String?         @map("whatsapp_account_id") @db.Uuid
  name             String
  status           CampaignStatus   @default(DRAFT)
  templateId       String           @map("template_id") @db.Uuid
  /// Snapshot at create: the template row may be renamed or re-categorised.
  templateName     String           @map("template_name")
  templateLanguage String           @map("template_language")
  templateCategory TemplateCategory @map("template_category")
  audienceSource   AudienceSource   @default(SEGMENT) @map("audience_source")
  /// Read only when `audienceSource` is SEGMENT; a list campaign ignores it.
  audienceTags     String[]         @default([]) @map("audience_tags")
  /// Token without braces -> how it is filled. Typed by `campaign.values.ts`.
  variables        Json             @default("{}")
  /// Button index -> the address a URL button opens, when it ends in a token.
  buttonUrls       Json             @default("{}") @map("button_urls")
  /// Meta requires opt-in for marketing; this records that the agent said so.
  optInConfirmed   Boolean          @default(false) @map("opt_in_confirmed")
  scheduledAt      DateTime?        @map("scheduled_at")
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  pausedAt         DateTime?        @map("paused_at")
  totalCount       Int              @default(0) @map("total_count")
  sentCount        Int              @default(0) @map("sent_count")
  failedCount      Int              @default(0) @map("failed_count")
  skippedCount     Int              @default(0) @map("skipped_count")
  createdByUserId  String?          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template   MessageTemplate     @relation(fields: [templateId], references: [id])
  recipients CampaignRecipient[]

  @@index([workspaceId, createdAt])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

/// One contact in one campaign. Delivery and read are NOT stored here: they
/// live on the `Message` row the webhook already advances, so there is exactly
/// one writer for them.
model CampaignRecipient {
  id          String          @id @default(uuid()) @db.Uuid
  campaignId  String          @map("campaign_id") @db.Uuid
  contactId   String          @map("contact_id") @db.Uuid
  /// Digits only, copied at materialisation so the row still reads correctly
  /// after a contact edit.
  waId        String          @map("wa_id")
  status      RecipientStatus @default(PENDING)
  messageId   String?         @unique @map("message_id") @db.Uuid
  errorReason String?         @map("error_reason")
  /// Capped by the runner; a row that keeps failing is left FAILED, not looped.
  attempts    Int             @default(0)
  /// Set while a batch holds the row. A claim older than a minute is stale and
  /// is offered again, which is how a restart resumes.
  claimedAt   DateTime?       @map("claimed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Cost and usage analytics.
//
// This is the one place AOTMS keeps Meta's own numbers locally, which the
// older dashboard deliberately refused to do. Retention is why: Meta answers
// `template_analytics` for 90 days only, and read/click counters are reset
// seven days after a send, so a live-only projection silently rewrites
// history. A daily snapshot keeps what Meta reported, verbatim.
//
// Ratios are never stored as window totals: `cost_per_delivered` is kept as
// Meta sent it for that day, and any wider ratio is recomputed at read time
// from summed numerator and denominator. Summing daily ratios is wrong.
//
// `costStatus` is the honesty switch. ACTUAL means Meta returned a figure;
// UNAVAILABLE means it returned none, which is normal for a Messaging account
// that shares a Solution Partner's credit line. There is deliberately no
// ESTIMATED member: nothing in this module may invent a number and label it as
// a Meta charge.
// ---------------------------------------------------------------------------

enum CostStatus {
  ACTUAL
  UNAVAILABLE
}

/// Where a figure came from. Only Meta is writable; the enum exists so a future
/// reader cannot mistake a local calculation for a reported charge.
enum AnalyticsSource {
  META
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
}

enum SyncStatus {
  RUNNING
  /// Every read Meta accepted and every write landed.
  OK
  /// Some reads succeeded, some did not; what succeeded is stored.
  PARTIAL
  FAILED
}

/// One template on one day, exactly as `template_analytics` reported it.
model TemplateDailyStat {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @map("workspace_id") @db.Uuid
  /// The connection these figures came from. Not a foreign key on purpose: a
  /// disconnected number must not erase the spend history it produced.
  whatsappAccountId  String          @map("whatsapp_account_id") @db.Uuid
  wabaId             String          @map("waba_id")
  /// Meta's template id — the identifier `template_analytics` answers for.
  templateId         String          @map("template_id")
  /// Our own row, when a matching `metaId` existed at sync time. Null for a
  /// template that only ever lived in WhatsApp Manager.
  messageTemplateId  String?         @map("message_template_id") @db.Uuid
  /// Snapshot at sync: a later rename must not rewrite what was reported.
  templateName       String          @map("template_name")
  category           String?
  date               DateTime        @db.Date
  sentCount          Int             @default(0) @map("sent_count")
  deliveredCount     Int             @default(0) @map("delivered_count")
  readCount          Int             @default(0) @map("read_count")
  clickedCount       Int             @default(0) @map("clicked_count")
  amountSpent        Decimal?        @map("amount_spent") @db.Decimal(18, 6)
  costPerDelivered   Decimal?        @map("cost_per_delivered") @db.Decimal(18, 6)
  costPerUrlClick    Decimal?        @map("cost_per_url_click") @db.Decimal(18, 6)
  /// The WABA's billing currency, read from Graph. Null while unknown.
  currency           String?
  costStatus         CostStatus      @default(UNAVAILABLE) @map("cost_status")
  source             AnalyticsSource @default(META)
  lastSyncedAt       DateTime        @map("last_synced_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Meta re-reports a day when late delivery receipts arrive, so a second sync
  /// must overwrite that day, never add a second row for it.
  @@unique([workspaceId, templateId, date])
  @@index([workspaceId, date])
  @@index([workspaceId, category, date])
  @@map("template_daily_stats")
}

/// One pricing breakdown row for one day, from `pricing_analytics`.
///
/// Meta answers across dimensions, so the breakdown columns are part of the
/// row's identity. Every dimension is a non-null string defaulting to "":
/// Postgres treats NULLs as distinct inside a unique index, so a nullable
/// column would let the same day be written twice.
model PricingDailyStat {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  whatsappAccountId String          @map("whatsapp_account_id") @db.Uuid
  wabaId            String          @map("waba_id")
  date              DateTime        @db.Date
  phoneNumber       String          @default("") @map("phone_number")
  country           String          @default("")
  pricingCategory   String          @default("") @map("pricing_category")
  pricingType       String          @default("") @map("pricing_type")
  /// Meta's `lower:upper` tier, e.g. `0:750000`, or `0:MAX` for marketing.
  tier              String          @default("")
  volume            Int             @default(0)
  cost              Decimal?        @map("cost") @db.Decimal(18, 6)
  currency          String?
  costStatus        CostStatus      @default(UNAVAILABLE) @map("cost_status")
  source            AnalyticsSource @default(META)
  lastSyncedAt      DateTime        @map("last_synced_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, phoneNumber, country, pricingCategory, pricingType, tier])
  @@index([workspaceId, date])
  @@map("pricing_daily_stats")
}

/// Where the last sync for a workspace stands, written by both the cron and the
/// Sync button, so the screen can name when it last actually succeeded rather
/// than when it last tried.
model AnalyticsSyncState {
  workspaceId       String      @id @map("workspace_id") @db.Uuid
  whatsappAccountId String?     @map("whatsapp_account_id") @db.Uuid
  wabaId            String?     @map("waba_id")
  /// The WABA's billing currency, as Graph reported it.
  currency          String?
  /// What the last completed run found: ACTUAL when Meta returned cost,
  /// UNAVAILABLE when it returned none for this billing arrangement.
  costStatus        CostStatus  @default(UNAVAILABLE) @map("cost_status")
  lastRunAt         DateTime?   @map("last_run_at")
  lastOkAt          DateTime?   @map("last_ok_at")
  lastError         String?     @map("last_error")
  /// Deepest day already stored, so a run can ask Meta for the gap only.
  syncedThrough     DateTime?   @db.Date @map("synced_through")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("analytics_sync_states")
}

/// Append-only log of sync attempts. A failure has to stay legible after the
/// fact; the state row only remembers the latest one.
model AnalyticsSyncRun {
  id            String      @id @default(uuid()) @db.Uuid
  workspaceId   String      @map("workspace_id") @db.Uuid
  trigger       SyncTrigger
  status        SyncStatus  @default(RUNNING)
  startedAt     DateTime    @default(now()) @map("started_at")
  finishedAt    DateTime?   @map("finished_at")
  /// Days asked of Meta, after the 90-day clamp.
  windowDays    Int         @default(0) @map("window_days")
  templatesRead Int         @default(0) @map("templates_read")
  templateRows  Int         @default(0) @map("template_rows")
  pricingRows   Int         @default(0) @map("pricing_rows")
  prunedRows    Int         @default(0) @map("pruned_rows")
  error         String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@map("analytics_sync_runs")
}

// ---------------------------------------------------------------------------
// AI agents
// ---------------------------------------------------------------------------

enum AgentSourceKind {
  TEXT
  FILE
}

enum AgentSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AgentRunKind {
  REPLY
  PLAYGROUND
}

enum AgentRunStatus {
  QUEUED
  CLAIMED
  SENT
  SKIPPED
  FAILED
}

/// One prompt and one knowledge base, bound to the number that answers.
/// "Training" is indexing: nothing here submits a fine-tune.
model Agent {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  whatsappAccountId String   @map("whatsapp_account_id") @db.Uuid
  name              String
  description       String?
  /// The instructions. Never a place for customer text: that arrives as a turn.
  systemPrompt      String   @map("system_prompt")
  model             String   @default("gpt-5.4-mini")
  temperature       Float    @default(0.4)
  maxReplyChars     Int      @default(900) @map("max_reply_chars")
  escalateKeywords  String[] @default([]) @map("escalate_keywords")
  /// On duty: eligible for routing. Several agents may be on duty on one
  /// number, and a thread stays with whichever one answered it first.
  isActive          Boolean  @default(false) @map("is_active")
  createdByUserId   String?  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       WhatsAppAccount   @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  sources       KnowledgeSource[]
  runs          AgentRun[]
  messages      Message[]
  /// Threads this agent answers. Ownership is set once per conversation.
  conversations Conversation[] @relation("ConversationAgent")
  /// The cards a customer walks through. One per agent, written whole.
  botFlow       BotFlow?

  @@index([whatsappAccountId, isActive])
  @@index([workspaceId, createdAt])
  @@map("agents")
}

/// The one interactive flow an agent owns: the cards a customer walks through.
/// Stored as a single JSON document because a flow is validated as a set -- an
/// entry card that exists, a button that points inside the flow -- and no card
/// is ever read on its own. `agentId` is unique, which is what makes a save an
/// upsert rather than a second row.
model BotFlow {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  agentId     String   @unique @map("agent_id") @db.Uuid
  data        Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("bot_flows")
}

/// One upload or typed note. `storagePath` survives the chunks, so a source can
/// be re-indexed against a new embedding model without asking for the file again.
model KnowledgeSource {
  id          String              @id @default(uuid()) @db.Uuid
  agentId     String              @map("agent_id") @db.Uuid
  kind        AgentSourceKind
  title       String
  mime        String?
  size        Int?
  storagePath String?             @map("storage_path")
  /// The extracted text, kept verbatim. Re-embedding reads this, not the vendor.
  text        String?
  status      AgentSourceStatus   @default(PENDING)
  error       String?
  charCount   Int                 @default(0) @map("char_count")
  chunkCount  Int                 @default(0) @map("chunk_count")
  embedTokens Int                 @default(0) @map("embed_tokens")
  /// Indexing attempts. A row that keeps failing is left FAILED, not looped.
  attempts    Int                 @default(0)
  /// The claim this row is currently held under. NULL when nobody holds it;
  /// `claim()` assigns a fresh UUID in the same UPDATE that makes the row
  /// PROCESSING, and every worker write matches it. `recoverStale` and `retry`
  /// set it back to NULL, so a suspended worker can never reclaim a row whose
  /// lease was handed on (the `attempts` ABA, B-17).
  leaseToken  String?             @map("lease_token") @db.Uuid
  indexedAt   DateTime?           @map("indexed_at")
  /// Lowercase hex SHA-256 of the stored bytes. Null for a typed note.
  sha256           String?   @db.Char(64)
  /// Who added it. Mirrors Agent.createdByUserId: a plain column, no relation,
  /// so the row survives the user being deleted.
  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  /// The source this one replaces. Plain column: a self-relation would cascade
  /// the successor away when the predecessor is retired.
  replacesSourceId String?   @map("replaces_source_id") @db.Uuid
  /// What the file *is*, not its content: sheet names and header rows for a
  /// workbook, pixel size for an image, page count for a PDF. Validated with
  /// zod on read; never pasted into a prompt.
  meta             Json?
  /// Tokens spent reading images and audio. Kept apart from `embedTokens` so
  /// the Usage screen keeps meaning what it says.
  extractTokens    Int       @default(0) @map("extract_tokens")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  agent  Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  /// Two identical files for one agent are a double charge and a duplicate
  /// answer. Partial in effect: typed notes have no hash, and NULLs never
  /// collide in Postgres.
  @@unique([agentId, sha256])
  @@index([agentId, createdAt])
  @@index([replacesSourceId])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  ord       Int
  text      String
  tokens    Int
  /// 1-based PDF page. Null for sources without pages.
  page      Int?
  /// CSV/XLSX sheet name.
  sheet     String?
  /// First and last data row this chunk covers, header excluded, 1-based.
  rowFrom   Int?     @map("row_from")
  rowTo     Int?     @map("row_to")
  /// Nearest preceding heading (DOCX, Markdown).
  heading   String?
  /// Nullable because Prisma can neither read nor write a vector: the row is
  /// created here and the vector is filled by raw SQL. A row with no embedding
  /// is invisible to search, which is exactly right for a half-finished index.
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now()) @map("created_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, ord])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

/// One claimable unit of AI work. A reply and a playground question are both
/// runs, so the usage screen has one table to sum.
model AgentRun {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  agentId           String         @map("agent_id") @db.Uuid
  kind              AgentRunKind   @default(REPLY)
  conversationId    String?        @map("conversation_id") @db.Uuid
  /// Unique: a retried Meta delivery can never produce a second reply.
  inboundMessageId  String?        @unique @map("inbound_message_id") @db.Uuid
  outboundMessageId String?        @map("outbound_message_id") @db.Uuid
  status            AgentRunStatus @default(QUEUED)
  /// Why a run was left unsent, in one word: paused, superseded, window-closed,
  /// no-context, no-agent, handoff.
  reason            String?
  tokensIn          Int            @default(0) @map("tokens_in")
  tokensOut         Int            @default(0) @map("tokens_out")
  embeddingTokens   Int            @default(0) @map("embedding_tokens")
  latencyMs         Int?           @map("latency_ms")
  error             String?
  attempts          Int            @default(0)
  claimedAt         DateTime?      @map("claimed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// CRM: lead stage, follow-up tasks and lead-routing settings.
//
// A lead is a conversation plus a stage, never a second copy of the message
// store. One open task per thread is enforced by a partial unique index that
// the migration writes by hand, because Prisma cannot express one.
// ---------------------------------------------------------------------------

/// What a customer's words said about buying. UNKNOWN is "nothing said yet".
enum LeadInterest {
  UNKNOWN
  INTERESTED
  NOT_INTERESTED
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

model FollowUpTask {
  id               String         @id @default(uuid()) @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  assignedToUserId String?        @map("assigned_to_user_id") @db.Uuid
  title            String
  note             String?
  dueAt            DateTime?      @map("due_at")
  status           FollowUpStatus @default(OPEN)
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueAt])
  @@index([assignedToUserId, status])
  @@map("follow_up_tasks")
}

/// Same shape as BusinessProfile: the workspace id is the key. A workspace
/// with no row reads the defaults in `crm.settings.ts`, not a seeded row.
model CrmSettings {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  leadDesignation String?  @map("lead_designation")
  autoAssign      Boolean  @default(true) @map("auto_assign")
  autoTask        Boolean  @default(true) @map("auto_task")
  taskDueHours    Int      @default(24) @map("task_due_hours")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("crm_settings")
}
