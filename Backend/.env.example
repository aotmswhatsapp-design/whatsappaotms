# Copy to .env and fill in. Never commit the real file.

APP_PORT=4000
NODE_ENV=development

# Supabase project URL (Project Settings -> API). Used as the JWT issuer and as
# the base for the JWKS endpoint at /auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed for projects still signing JWTs with the legacy HS256 secret.
# Leave empty to verify against the project JWKS instead (the current default).
SUPABASE_JWT_SECRET=+rx2KuCeRDfqd8rvf6Bw2z29YVt5ant6XaeRm4UAEIXSzYEc+z+l/8LqFJwBRQ74UBXsdoWLc2ygNkocLatHEw==

# Connection string for Prisma (Transaction Pooler - IPv4 compatible for Render).
SUPABASE_POSTGRES_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session Pooler connection string used by Prisma migrations.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
