# Copy to .env and fill in. Never commit the real file.

APP_PORT=4000
NODE_ENV=development

# Supabase project URL (Project Settings -> API). Used as the JWT issuer and as
# the base for the JWKS endpoint at /auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed for projects still signing JWTs with the legacy HS256 secret.
# Leave empty to verify against the project JWKS instead (the current default).
SUPABASE_JWT_SECRET=+rx2KuCeRDfqd8rvf6Bw2z29YVt5ant6XaeRm4UAEIXSzYEc+z+l/8LqFJwBRQ74UBXsdoWLc2ygNkocLatHEw==

# Connection string for Prisma. For the transaction pooler append
# ?pgbouncer=true&connection_limit=1 when running migrations from CI.
SUPABASE_POSTGRES_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
