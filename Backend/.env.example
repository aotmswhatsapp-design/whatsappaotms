# Copy to .env and fill in. Never commit the real file.

APP_PORT=4000
NODE_ENV=development

# Supabase project URL (Project Settings -> API). It is the JWT issuer, the base
# of the JWKS endpoint at /auth/v1/.well-known/jwks.json, and the host for the
# auth REST calls the API makes on your behalf.
SUPABASE_URL=https://<project-ref>.supabase.co

# API keys (Project Settings -> API Keys).
#
# Publishable key (`sb_publishable_…`, or the legacy `anon` JWT). The server
# needs its own copy for POST /auth/v1/resend, which backs the throttled
# /api/v1/auth/confirm/resend route. Left empty, that route answers 503 and the
# browser resends the code itself.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (`sb_secret_…`, or the legacy `service_role` JWT). Never reaches a
# browser; only admin tooling such as scripts/create-user.mjs uses it.
SUPABASE_SECRET_KEY=

# Legacy symmetric signing only. Leave this empty on any project that publishes
# a JWKS: an ES256 project with an HS256 secret here verifies nothing. The
# verifier picks its key source from each token's header, so ES256 keeps
# working either way — but setting this only adds a way to be wrong.
# Never commit a real value here — this file is tracked by git.
SUPABASE_JWT_SECRET=

# Connection string for Prisma.
#
# Use the Supavisor POOLER, not the direct host. Supabase's direct endpoint
# (db.<ref>.supabase.co:5432) is IPv6-only, and hosts such as Render have no
# IPv6 egress — Prisma then fails at boot with P1001 "Can't reach database
# server". Copy the exact string from Supabase Dashboard -> Connect:
#   session pooler     : <region>.pooler.supabase.com:5432  (prepared statements OK)
#   transaction pooler : <region>.pooler.supabase.com:6543  (append ?pgbouncer=true)
# The pooler user is postgres.<project-ref>, and the password must be
# percent-encoded (%40 for @, %23 for #) because it sits inside a URL.
SUPABASE_POSTGRES_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session-mode connection on port 5432. Passed to Prisma as `directUrl`, so
# `prisma migrate` runs over this instead of the transaction pooler — the
# pooler cannot carry the prepared statements a migration needs and fails with
# "prepared statement s1 already exists". Runtime queries still use
# SUPABASE_POSTGRES_URL above.
DIRECT_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres

# Hashes to a 32-byte AES-256-GCM key that seals WhatsApp tokens at rest.
# Any high-entropy string of 32+ characters. Rotating it invalidates every
# stored WhatsApp credential, which is the intended failure mode.
WHATSAPP_ENCRYPTION_KEY=<at-least-32-random-characters>

# Where Supabase sends the OAuth callback. Register this exact URL as an
# authorised redirect URI on the Google OAuth client.
callback_url=https://<project-ref>.supabase.co/auth/v1/callback

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Global per-IP rate limit: window in ms, requests allowed per window.
# POST /api/v1/auth/confirm/resend declares a tighter 5/minute of its own.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
