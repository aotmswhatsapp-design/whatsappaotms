# Copy to .env and fill in. Never commit the real file.

# Local port only. Omit APP_PORT entirely on a hosting platform such as Render
# or Railway: they inject PORT and route traffic to that number, so a value here
# makes the API listen where nothing is routed (502) and a blank value fails
# validation. Clearing it leaves the platform's PORT in charge.
APP_PORT=4000
NODE_ENV=development

# Supabase project URL (Project Settings -> API). It is the JWT issuer, the base
# of the JWKS endpoint at /auth/v1/.well-known/jwks.json, and the host for the
# auth REST calls the API makes on your behalf.
SUPABASE_URL=https://<project-ref>.supabase.co

# API keys (Project Settings -> API Keys).
#
# Publishable key (`sb_publishable_…`, or the legacy `anon` JWT). The server
# needs its own copy for POST /auth/v1/resend, which backs the throttled
# /api/v1/auth/confirm/resend route. Left empty, that route answers 503 and the
# browser resends the code itself.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (`sb_secret_…`, or the legacy `service_role` JWT). Never reaches a
# browser. It backs media storage for the inbox: attachments are written to a
# private bucket and read through short-lived signed URLs, so without this key
# the API still boots and media answers 503.
SUPABASE_SECRET_KEY=

# Private bucket that holds inbox attachments. Created on the first upload.
INBOX_MEDIA_BUCKET=inbox-media

# Private bucket that holds template header samples. Separate from inbox
# attachments so a retention sweep of one never touches the other; it is
# created on the first template upload and read back through signed URLs.
TEMPLATE_MEDIA_BUCKET=template-media

# Legacy symmetric signing only. Leave this empty on any project that publishes
# a JWKS: an ES256 project with an HS256 secret here verifies nothing. The
# verifier picks its key source from each token's header, so ES256 keeps
# working either way — but setting this only adds a way to be wrong.
# Never commit a real value here — this file is tracked by git.
SUPABASE_JWT_SECRET=

# Connection string for Prisma.
#
# Use the Supavisor POOLER, not the direct host. Supabase's direct endpoint
# (db.<ref>.supabase.co:5432) is IPv6-only, and hosts such as Render have no
# IPv6 egress — Prisma then fails at boot with P1001 "Can't reach database
# server". Copy the exact string from Supabase Dashboard -> Connect:
#   session pooler     : <region>.pooler.supabase.com:5432  (prepared statements OK)
#   transaction pooler : <region>.pooler.supabase.com:6543  (append ?pgbouncer=true)
# The pooler user is postgres.<project-ref>, and the password must be
# percent-encoded (%40 for @, %23 for #) because it sits inside a URL.
SUPABASE_POSTGRES_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session-mode connection on port 5432. Passed to Prisma as `directUrl`, so
# `prisma migrate` runs over this instead of the transaction pooler — the
# pooler cannot carry the prepared statements a migration needs and fails with
# "prepared statement s1 already exists". Runtime queries still use
# SUPABASE_POSTGRES_URL above.
DIRECT_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres

# Hashes to a 32-byte AES-256-GCM key that seals WhatsApp tokens at rest.
# Any high-entropy string of 32+ characters. Rotating it invalidates every
# stored WhatsApp credential, which is the intended failure mode.
WHATSAPP_ENCRYPTION_KEY=<at-least-32-random-characters>

# The URL Meta posts to, exactly as registered in the app's Webhooks panel.
# Local development cannot receive it, so this stays unset there and the
# connection screen says the callback is not configured. Production:
#   WHATSAPP_WEBHOOK_PUBLIC_URL=https://api.aotms.com/api/v1/whatsapp/webhook
WHATSAPP_WEBHOOK_PUBLIC_URL=

# --- Meta credentials --------------------------------------------------------
# Every workspace brings its own Meta app: the customer's (or the operator's,
# created on site) access token, phone number ID, app secret, Graph version and
# WhatsApp account ID are entered and verified on the WhatsApp screen, then
# sealed with WHATSAPP_ENCRYPTION_KEY. Each workspace also gets its own
# generated `wa_...` verify token, which is pasted into the Webhooks panel of
# that same app.
#
# The one exception is META_APP_ID below: the Resumable Upload API names the app
# in its URL, and a template image cannot be uploaded without it. It is the app
# that owns the tokens customers enter — AOTMS's own app in the hosted product.
#
# Numeric app id (App Dashboard -> Settings -> Basic). It names the app in the
# Resumable Upload URL, and with the three values below it also powers one-click
# WhatsApp setup. Leave them all empty if this deployment never creates image
# templates and never runs Embedded Signup: text templates work unchanged, an
# image header answers 503 naming this variable, and the connection screen leads
# with the credentials form instead of the one-click button.
META_APP_ID=

# --- Embedded Signup (optional) ----------------------------------------------
# Meta app secret for the same app as META_APP_ID. It signs the server-side
# OAuth code exchange, the `debug_token` call and every webhook delivery from a
# one-click connection. Never send it to the browser.
# App Dashboard -> Settings -> Basic -> App secret.
META_APP_SECRET=

# The Facebook Login for Business configuration that carries WhatsApp Embedded
# Signup. It must belong to the SAME app as META_APP_ID; a configuration from
# another app fails in the dialog with a scopes error that looks like a bug.
# App Dashboard -> Facebook Login for Business -> Configurations.
META_ES_CONFIG_ID=

# Graph version used for the code exchange, `subscribed_apps` and `debug_token`.
# Each stored connection keeps its own `graph_version` for sends, so changing
# this never migrates existing rows.
META_GRAPH_VERSION=v23.0

# The token pasted into that app's single Webhooks panel. Meta echoes it back on
# the GET handshake. With a platform app the callback URL is verified once for
# the whole deployment, so one-click rows carry no per-workspace token.
# Invent it here and paste the same string into Meta; Meta never issues one.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# How long a stored connection verdict is trusted before the status endpoint
# asks Graph again. Five minutes keeps a page load cheap without letting a
# revoked token look healthy for long.
WHATSAPP_STATUS_TTL_MS=300000

# Where Supabase sends the OAuth callback. Register this exact URL as an
# authorised redirect URI on the Google OAuth client.
callback_url=https://<project-ref>.supabase.co/auth/v1/callback

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Global per-IP rate limit: window in ms, requests allowed per window.
# POST /api/v1/auth/confirm/resend declares a tighter 5/minute of its own.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
